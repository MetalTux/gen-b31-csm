// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Tablas necesarias para NextAuth (Autenticación) ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Tablas principales del Sistema ---

enum Role {
  USER
  ADMIN
}

enum BoardPosition {
  PRESIDENTE
  SECRETARIO
  TESORERO
}

// --- ENUMS PARA CONSULTAS ---
enum InquiryCategory {
  ACADEMICA
  FINANCIERA
  LOGISTICA
  GENERAL
}

enum InquiryStatus {
  PENDIENTE
  RESPONDIDA
  CERRADA
}

// --- ENUM PARA EL CALENDARIO ---
enum EventCategory {
  ACADEMICO     // Pruebas, entregas de trabajos, presentaciones
  REUNION       // Reuniones de apoderados o directiva
  ACTIVIDAD     // Paseos, viajes de estudio, convivencias
  FERIADO       // Días sin clases o feriados legales
  OTRO          // Cualquier otro evento misceláneo
}

// --- ENUM PARA ENCUESTAS DINÁMICAS ---
enum QuestionType {
  SINGLE_CHOICE   // Ej: Elija solo un menú
  MULTIPLE_CHOICE // Ej: Elija las actividades en las que participará
  QUANTITY        // Ej: Reparta 3 empanadas entre estos sabores
}

// Configuración del Año Escolar
model SchoolYear {
  id                String     @id @default(cuid())
  year              Int        @unique // Ej: 2026
  className         String     // Ej: "7 Básico B" o "8 Básico B"
  isActive          Boolean    @default(false) // Solo un año debería estar activo a la vez
  
  // Cantidad mínima de cuotas base requeridas para este año
  minimumBaseQuotas Int        @default(10)
  
  initialBalance    Float      @default(0)     // Saldo a favor/contra del año anterior
  quotaAmount       Float      // Monto de la cuota regular
  totalQuotas       Int        // Cantidad total de cuotas en el año (ej: 10)
  teacherName       String?    // Nombre del profesor(a) jefe
  
  // Relaciones históricas
  payments          Payment[]
  expenses          Expense[]
  
  // --- NUEVO: Relación con la tabla de Ingresos Generales del curso ---
  generalIncomes    GeneralIncome[]

  activities        Activity[]
  extraFees         ExtraFee[]
  polls             Poll[]
  inquiries         Inquiry[]   
  events            Event[]     // Eventos del año escolar
}

// Tabla de Usuarios
model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?

  isActive         Boolean           @default(true)
  
  role             Role              @default(USER) 
  boardPosition    BoardPosition? 
  
  // Campos para enlace de acceso directo (Magic Link)
  loginToken       String?           @unique
  loginTokenExpires DateTime?
  
  accounts         Account[]
  sessions         Session[]
  students         Student[]      
  payments         Payment[]
  comments         Comment[]
  pollVotes        PollVote[]
  inquiries        Inquiry[]          
  inquiryResponses InquiryResponse[]  
  createdEvents    Event[]           // Eventos creados por el admin
}

// Tabla de Alumnos
model Student {
  id               String     @id @default(cuid())
  firstName        String
  lastName         String
  orderNumber      Int        @default(0)
  isActive         Boolean    @default(true) 
  startQuotaNumber Int        @default(1)
  
  parents          User[]   
  payments         Payment[]
  pollVotes        PollVote[]
  inquiries        Inquiry[]  
  
  // Relación de muchos a muchos para Cobros Extra específicos asignados a este alumno
  assignedExtraFees ExtraFee[] @relation("AssignedExtraFees")
}

// Cobros Extraordinarios (Ej: Cumpleaños, Paseos)
model ExtraFee {
  id               String     @id @default(cuid())
  title            String
  description      String?    @db.Text
  amount           Float
  dueDate          DateTime?
  
  // Determina si este cobro aplica a todos los alumnos por defecto
  isGlobal         Boolean    @default(true) 
  
  schoolYearId     String
  schoolYear       SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  
  payments         Payment[]
  
  // Si isGlobal es false, aquí guardamos a qué alumnos se les cobra
  assignedStudents Student[]  @relation("AssignedExtraFees")
}

// Tabla de Pagos (Cuotas regulares o Extraordinarios)
model Payment {
  id           String    @id @default(cuid())
  amount       Float
  date         DateTime  @default(now())
  isVerified   Boolean   @default(false) 
  receiptUrl   String?  
  
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  
  quotaNumber  Int?      
  extraFeeId   String?   
  extraFee     ExtraFee? @relation(fields: [extraFeeId], references: [id], onDelete: SetNull)
  
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  studentId    String?  
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
}

// Tabla de Gastos del Curso
model Expense {
  id           String     @id @default(cuid())
  amount       Float
  date         DateTime   @default(now())
  concept      String   
  receiptUrl   String?  
  
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
}

// --- NUEVO: Tabla de Ingresos Generales (Pro-fondos, Ventas, etc.) ---
model GeneralIncome {
  id           String     @id @default(cuid())
  amount       Float
  date         DateTime   @default(now())
  concept      String     // Ej: "Venta de Garage", "Rifa Solidaria"
  receiptUrl   String?    // Por si quieren subir alguna foto o comprobante
  
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  
  createdAt    DateTime   @default(now())
}

// Tabla de Actividades (Blog de novedades)
model Activity {
  id           String     @id @default(cuid())
  title        String
  description  String?    @db.Text
  date         DateTime
  documentUrl  String?  
  createdAt    DateTime   @default(now())
  
  schoolYearId String
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  
  comments     Comment[]  // Relación con los comentarios recibidos
}

// Tabla de Comentarios (Interacción tipo blog)
model Comment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  createdAt  DateTime @default(now())
  
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- ARQUITECTURA PARA ENCUESTAS DINÁMICAS ---

// 1. Tabla principal de la Encuesta/Formulario
model Poll {
  id           String         @id @default(cuid())
  title        String         // Ej: "Formulario Paseo de Fin de Año"
  description  String?        @db.Text
  createdAt    DateTime       @default(now())
  expiresAt    DateTime?      
  isActive     Boolean        @default(true)
  
  schoolYearId String
  schoolYear   SchoolYear     @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  
  // Ahora la encuesta está dividida en preguntas/secciones
  questions    PollQuestion[] 
}

// 2. Las secciones o preguntas de una encuesta
model PollQuestion {
  id               String       @id @default(cuid())
  title            String       // Ej: "Indique los sabores de empanadas"
  type             QuestionType @default(SINGLE_CHOICE)
  
  maxSelections    Int?         // Para MULTIPLE_CHOICE (Ej: Elija máximo 2 opciones)
  maxTotalQuantity Int?         // Para QUANTITY (Ej: Máximo 3 empanadas en total)
  
  pollId           String
  poll             Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  
  options          PollOption[]
  votes            PollVote[]
}

// 3. Las opciones a elegir dentro de una pregunta
model PollOption {
  id           String       @id @default(cuid())
  text         String       // Ej: "Pino", "Queso"
  isCustomText Boolean      @default(false) // Si es TRUE, abre caja de texto para "Otros"
  
  questionId   String
  question     PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  votes        PollVote[]
}

// 4. Los votos emitidos
model PollVote {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  
  // Cantidad asignada a esta opción específica
  quantity     Int          @default(1)
  
  // Texto capturado si la opción era "isCustomText" (Otros)
  customText   String?      @db.Text
  
  questionId   String
  question     PollQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  pollOptionId String
  pollOption   PollOption   @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId    String
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // REGLA CLAVE: Un alumno solo puede tener UN registro por opción, por pregunta.
  // Si quiere 2 de pino, se actualiza la "quantity" en esa misma fila, no se crean dos filas.
  @@unique([questionId, pollOptionId, studentId]) 
}

// --- TABLAS PARA MÓDULO DE CONSULTAS (HELPDESK) ---

model Inquiry {
  id           String          @id @default(cuid())
  title        String
  content      String          @db.Text
  category     InquiryCategory
  status       InquiryStatus   @default(PENDIENTE)
  isPublic     Boolean         @default(true)
  
  schoolYearId String
  schoolYear   SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  studentId    String?
  student      Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  
  responses    InquiryResponse[]
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model InquiryResponse {
  id        String   @id @default(cuid())
  content   String   @db.Text
  
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

// --- TABLA PARA EL MÓDULO DE CALENDARIO ---

model Event {
  id           String        @id @default(cuid())
  title        String
  description  String?       @db.Text
  location     String?       // Ej: "Sala 7B", "Gimnasio", "Zoológico"
  
  startDate    DateTime      // Fecha y hora de inicio
  endDate      DateTime?     // Fecha y hora de término (opcional)
  isAllDay     Boolean       @default(false) // Si es true, ignoramos las horas de las fechas anteriores
  
  category     EventCategory @default(OTRO)
  
  schoolYearId String
  schoolYear   SchoolYear    @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}